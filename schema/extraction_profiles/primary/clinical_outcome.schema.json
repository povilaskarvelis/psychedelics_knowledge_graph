{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Primary Clinical Outcome Extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "route_id",
    "study_doi",
    "domain_route",
    "paper_type",
    "text_depth",
    "extraction_status",
    "items",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "primary_clinical_outcome_v1"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "study_doi": {
      "type": "string"
    },
    "domain_route": {
      "type": "string",
      "const": "clinical_outcome"
    },
    "paper_type": {
      "type": "string",
      "enum": [
        "primary_study"
      ]
    },
    "text_depth": {
      "type": "string",
      "enum": [
        "article_text",
        "abstract_only"
      ]
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "extracted",
        "no_extractable_scoped_evidence",
        "wrong_source_type",
        "not_relevant",
        "human_review"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_type": {
      "type": "string"
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_or_population",
        "compound_or_intervention",
        "comparator",
        "dose_or_regimen",
        "sample_size",
        "outcome_measure",
        "clinical_endpoint",
        "assessment_timepoint",
        "result_direction",
        "effect_or_statistic",
        "finding_summary",
        "evidence_location",
        "evidence_locator",
        "study_design"
      ],
      "properties": {
        "condition_or_population": {
          "type": "string",
          "description": "Legacy combined clinical label. Prefer filling condition_or_indication and population_or_subgroup separately when possible."
        },
        "condition_or_indication": {
          "type": "string",
          "description": "Clean clinical condition or treatment indication that should become the graph node, such as major depressive disorder, treatment-resistant depression, opioid use disorder, suicidality, fibromyalgia, migraine, or alcohol use disorder. Do not include age, sex, recruitment source, treatment resistance details, or other subgroup wording unless it is part of the condition name. Do not use disease-model or drug-challenge phrases such as schizophrenia-like symptoms, psychosis-like effects, depression-like behavior, dissociation, or perceptual alterations as a condition; use not_applicable or not_reported unless participants actually had the condition."
        },
        "population_or_subgroup": {
          "type": "string",
          "description": "Participant group, demographic subgroup, clinical subgroup, or eligibility context, such as older adults, veterans, healthy volunteers, treatment-resistant subgroup, postoperative patients, or participants with comorbid anxiety. Keep this separate from the condition graph label."
        },
        "population_model_category": {
          "type": "string",
          "enum": [
            "clinical_population",
            "healthy_volunteers",
            "human_participants",
            "community_sample",
            "veterans",
            "adolescents_youth",
            "older_adults",
            "mouse_model",
            "rat_model",
            "animal_model",
            "in_vitro_cell_model",
            "ex_vivo_tissue_model",
            "computational_model",
            "mixed_or_unclear",
            "not_reported"
          ],
          "description": "Coarse population/model bucket for filtering and UI facets. Use the closest allowed value."
        },
        "compound_or_intervention": {
          "type": "string",
          "description": "Psychedelic, ketamine, entactogen, or other explicitly studied graph exposure. Do not put an addiction service, psychotherapy component, comparator, condition, or outcome here; preserve those in their corresponding fields."
        },
        "comparator": {
          "type": "string"
        },
        "dose_or_regimen": {
          "type": "string",
          "description": "Paper wording for dose, route, schedule, session count, and regimen. Prefer also filling administration_route, dosing_schedule, and session_context when stated."
        },
        "administration_route": {
          "type": "string",
          "enum": [
            "oral_or_sublingual",
            "intravenous",
            "intranasal",
            "subcutaneous_or_intramuscular",
            "smoked_or_vaporized",
            "preclinical_injection",
            "other",
            "not_reported"
          ],
          "description": "Route of administration as a coarse controlled value when stated."
        },
        "dosing_schedule": {
          "type": "string",
          "enum": [
            "single_dose",
            "repeated_dosing",
            "dose_ranging",
            "microdosing",
            "maintenance_or_course",
            "other",
            "not_reported"
          ],
          "description": "Coarse dosing schedule when stated."
        },
        "session_context": {
          "type": "string",
          "enum": [
            "therapy_assisted_session",
            "ceremony_or_retreat",
            "clinical_administration",
            "naturalistic_use",
            "preclinical_experiment",
            "not_reported",
            "other"
          ],
          "description": "Session or setting context when it is part of the finding."
        },
        "sample_size": {
          "type": "string"
        },
        "outcome_measure": {
          "type": "string"
        },
        "clinical_endpoint": {
          "type": "string"
        },
        "assessment_timepoint": {
          "type": "string",
          "description": "When the finding was measured or assessed, such as acute session, 2 hours post-dose, end of treatment, week 6, or follow-up. Use the paper's wording when available."
        },
        "result_direction": {
          "type": "string",
          "enum": [
            "positive",
            "negative",
            "no_detected_effect",
            "mixed",
            "unclear",
            "not_applicable"
          ]
        },
        "effect_or_statistic": {
          "type": "string"
        },
        "finding_summary": {
          "type": "string"
        },
        "evidence_location": {
          "type": "string"
        },
        "evidence_locator": {
          "type": "string"
        },
        "study_design": {
          "type": "string"
        },
        "study_design_category": {
          "type": "string",
          "enum": [
            "rct",
            "phase_2_rct",
            "phase_3_rct",
            "open_label",
            "single_arm_trial",
            "clinical_trial",
            "observational",
            "retrospective",
            "case_report",
            "case_series",
            "qualitative",
            "preclinical_experiment",
            "ex_vivo_experiment",
            "in_vitro_assay",
            "binding_assay",
            "functional_assay",
            "computational",
            "pharmacovigilance",
            "wastewater_surveillance",
            "dose_finding",
            "post_hoc",
            "follow_up",
            "review",
            "systematic_review",
            "meta_analysis",
            "other",
            "not_reported"
          ],
          "description": "Coarse study-design bucket for filtering and UI facets. Use the closest allowed value."
        }
      }
    }
  }
}
