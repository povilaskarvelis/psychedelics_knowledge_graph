{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Primary Real-World Public Health Extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "route_id",
    "study_doi",
    "domain_route",
    "paper_type",
    "text_depth",
    "extraction_status",
    "items",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "primary_real_world_public_health_v1"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "study_doi": {
      "type": "string"
    },
    "domain_route": {
      "type": "string",
      "const": "real_world_public_health"
    },
    "paper_type": {
      "type": "string",
      "enum": [
        "primary_study"
      ]
    },
    "text_depth": {
      "type": "string",
      "enum": [
        "article_text",
        "abstract_only"
      ]
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "extracted",
        "no_extractable_scoped_evidence",
        "wrong_source_type",
        "not_relevant",
        "human_review"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_type": {
      "type": "string"
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure_or_policy",
        "population",
        "sample_size",
        "setting",
        "public_health_topic_category",
        "public_health_measure",
        "study_design",
        "estimate_value",
        "effect_or_statistic",
        "estimate_unit",
        "association_or_trend",
        "time_window",
        "finding_summary",
        "evidence_location",
        "evidence_locator"
      ],
      "properties": {
        "exposure_or_policy": {
          "type": "string"
        },
        "population": {
          "type": "string"
        },
        "sample_size": {
          "type": "string",
          "description": "Actual unweighted number of participants, respondents, records, cases, samples, sites, or observations used for the finding. Do not use weighted population estimates as the sample size; include them in estimate_value or finding_summary when relevant."
        },
        "setting": {
          "type": "string"
        },
        "public_health_topic_category": {
          "type": "string",
          "description": "Stable public-health or naturalistic-use topic for the graph node, such as Microdosing, Recreational use, Self-treatment, Ceremonial/retreat use, Polysubstance use, Prevalence & trends, Problematic use, Drug checking & adulteration, Emergency/toxicology reports, Wastewater & market signals, Access to services, or Legal/criminal justice."
        },
        "public_health_measure": {
          "type": "string"
        },
        "data_source_type": {
          "type": "string",
          "enum": [
            "survey",
            "poison_center_toxicology",
            "wastewater",
            "drug_checking",
            "administrative_registry",
            "qualitative_interview",
            "observational_cohort",
            "other_or_unclear",
            "not_reported"
          ],
          "description": "Primary real-world data source type supporting the finding."
        },
        "study_design": {
          "type": "string"
        },
        "study_design_category": {
          "type": "string",
          "enum": [
            "rct",
            "phase_2_rct",
            "phase_3_rct",
            "open_label",
            "single_arm_trial",
            "clinical_trial",
            "observational",
            "retrospective",
            "case_report",
            "case_series",
            "qualitative",
            "preclinical_experiment",
            "ex_vivo_experiment",
            "in_vitro_assay",
            "binding_assay",
            "functional_assay",
            "computational",
            "pharmacovigilance",
            "wastewater_surveillance",
            "dose_finding",
            "post_hoc",
            "follow_up",
            "review",
            "systematic_review",
            "meta_analysis",
            "other",
            "not_reported"
          ],
          "description": "Coarse study-design bucket for filtering and UI facets. Use the closest allowed value."
        },
        "estimate_value": {
          "type": "string"
        },
        "effect_or_statistic": {
          "type": "string"
        },
        "estimate_unit": {
          "type": "string"
        },
        "association_or_trend": {
          "type": "string"
        },
        "time_window": {
          "type": "string",
          "description": "The time period covered by the estimate, association, outcome, or observation. Use the paper's wording when available."
        },
        "finding_summary": {
          "type": "string"
        },
        "evidence_location": {
          "type": "string"
        },
        "evidence_locator": {
          "type": "string"
        }
      }
    }
  }
}
