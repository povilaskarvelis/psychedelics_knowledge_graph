{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Primary Cognitive Behavioral Extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "route_id",
    "study_doi",
    "domain_route",
    "paper_type",
    "text_depth",
    "extraction_status",
    "items",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "primary_cognitive_behavioral_v1"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "study_doi": {
      "type": "string"
    },
    "domain_route": {
      "type": "string",
      "const": "cognitive_behavioral"
    },
    "paper_type": {
      "type": "string",
      "enum": [
        "primary_study"
      ]
    },
    "text_depth": {
      "type": "string",
      "enum": [
        "article_text",
        "abstract_only"
      ]
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "extracted",
        "no_extractable_scoped_evidence",
        "wrong_source_type",
        "not_relevant",
        "human_review"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_type": {
      "type": "string"
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compound_or_exposure",
        "population_or_species",
        "sample_size",
        "study_design",
        "construct_or_behavior",
        "task_or_measure",
        "behavioral_context",
        "comparator",
        "dose_or_regimen",
        "assessment_timepoint",
        "statistic_or_value",
        "effect_or_statistic",
        "finding_summary",
        "evidence_location",
        "evidence_locator"
      ],
      "properties": {
        "compound_or_exposure": {
          "type": "string"
        },
        "population_or_species": {
          "type": "string"
        },
        "population_model_category": {
          "type": "string",
          "enum": [
            "clinical_population",
            "healthy_volunteers",
            "human_participants",
            "community_sample",
            "veterans",
            "adolescents_youth",
            "older_adults",
            "mouse_model",
            "rat_model",
            "animal_model",
            "in_vitro_cell_model",
            "ex_vivo_tissue_model",
            "computational_model",
            "mixed_or_unclear",
            "not_reported"
          ],
          "description": "Coarse population/model bucket for filtering and UI facets. Use the closest allowed value."
        },
        "sample_size": {
          "type": "string"
        },
        "study_design": {
          "type": "string"
        },
        "study_design_category": {
          "type": "string",
          "enum": [
            "rct",
            "phase_2_rct",
            "phase_3_rct",
            "open_label",
            "single_arm_trial",
            "clinical_trial",
            "observational",
            "retrospective",
            "case_report",
            "case_series",
            "qualitative",
            "preclinical_experiment",
            "ex_vivo_experiment",
            "in_vitro_assay",
            "binding_assay",
            "functional_assay",
            "computational",
            "pharmacovigilance",
            "wastewater_surveillance",
            "dose_finding",
            "post_hoc",
            "follow_up",
            "review",
            "systematic_review",
            "meta_analysis",
            "other",
            "not_reported"
          ],
          "description": "Coarse study-design bucket for filtering and UI facets. Use the closest allowed value."
        },
        "construct_or_behavior": {
          "type": "string",
          "description": "Legacy construct or behavior field. Prefer also filling graph_construct_label with the clean user-facing graph node label."
        },
        "graph_construct_label": {
          "type": "string",
          "description": "Clean user-facing cognition or behavior construct for the graph node, such as working memory, cognitive flexibility, fear extinction, reward processing, social cognition, drug seeking, conditioned place preference, head-twitch response, threat avoidance, or pain behavior. Do not use raw assay names, generic locomotor labels, neural readouts, clinical symptoms, or molecular pathways as graph construct labels."
        },
        "construct_family": {
          "type": "string",
          "enum": [
            "cognition",
            "behavior",
            "mixed_or_unclear",
            "not_reported"
          ],
          "description": "Whether the graph construct is primarily cognitive or behavioral. Use behavior for animal behavioral assays and cognition for cognitive constructs or cognitive task domains."
        },
        "task_or_measure": {
          "type": "string",
          "description": "Task, assay, scale, behavioral test, or measured outcome. Keep raw task or measure wording here rather than in graph_construct_label."
        },
        "raw_task_or_measure": {
          "type": "string",
          "description": "Paper wording for the task, assay, instrument, or measured behavior when it differs from the clean graph construct label."
        },
        "behavioral_context": {
          "type": "string"
        },
        "comparator": {
          "type": "string"
        },
        "dose_or_regimen": {
          "type": "string",
          "description": "Paper wording for dose, route, schedule, session count, and regimen. Prefer also filling administration_route, dosing_schedule, and session_context when stated."
        },
        "administration_route": {
          "type": "string",
          "enum": [
            "oral_or_sublingual",
            "intravenous",
            "intranasal",
            "subcutaneous_or_intramuscular",
            "smoked_or_vaporized",
            "preclinical_injection",
            "other",
            "not_reported"
          ],
          "description": "Route of administration as a coarse controlled value when stated."
        },
        "dosing_schedule": {
          "type": "string",
          "enum": [
            "single_dose",
            "repeated_dosing",
            "dose_ranging",
            "microdosing",
            "maintenance_or_course",
            "other",
            "not_reported"
          ],
          "description": "Coarse dosing schedule when stated."
        },
        "session_context": {
          "type": "string",
          "enum": [
            "therapy_assisted_session",
            "ceremony_or_retreat",
            "clinical_administration",
            "naturalistic_use",
            "preclinical_experiment",
            "not_reported",
            "other"
          ],
          "description": "Session or setting context when it is part of the finding."
        },
        "assessment_timepoint": {
          "type": "string",
          "description": "When the finding was measured or assessed, such as acute session, 2 hours post-dose, end of treatment, week 6, or follow-up. Use the paper's wording when available."
        },
        "statistic_or_value": {
          "type": "string",
          "description": "The main reported numeric/statistical value for the finding when no more specific value field applies, such as beta, r, mean difference, percent change, or a reported qualitative value."
        },
        "effect_or_statistic": {
          "type": "string"
        },
        "finding_summary": {
          "type": "string"
        },
        "evidence_location": {
          "type": "string"
        },
        "evidence_locator": {
          "type": "string"
        }
      }
    }
  }
}
