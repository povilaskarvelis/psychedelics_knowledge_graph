{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Primary Molecular Target Extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "route_id",
    "study_doi",
    "domain_route",
    "paper_type",
    "text_depth",
    "extraction_status",
    "items",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "primary_molecular_target_v1"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "study_doi": {
      "type": "string"
    },
    "domain_route": {
      "type": "string",
      "const": "molecular_target"
    },
    "paper_type": {
      "type": "string",
      "enum": [
        "primary_study"
      ]
    },
    "text_depth": {
      "type": "string",
      "enum": [
        "article_text",
        "abstract_only"
      ]
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "extracted",
        "no_extractable_scoped_evidence",
        "wrong_source_type",
        "not_relevant",
        "human_review"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_type": {
      "type": "string"
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compound",
        "target",
        "target_type",
        "assay_type",
        "system",
        "sample_size",
        "study_design",
        "species_or_cell_line",
        "action_type",
        "metric",
        "value",
        "effect_or_statistic",
        "unit",
        "comparator_or_reference",
        "finding_summary",
        "evidence_location",
        "evidence_locator"
      ],
      "properties": {
        "compound": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "target_type": {
          "type": "string"
        },
        "assay_type": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "sample_size": {
          "type": "string"
        },
        "study_design": {
          "type": "string"
        },
        "species_or_cell_line": {
          "type": "string"
        },
        "action_type": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "effect_or_statistic": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "comparator_or_reference": {
          "type": "string"
        },
        "finding_summary": {
          "type": "string"
        },
        "evidence_location": {
          "type": "string"
        },
        "evidence_locator": {
          "type": "string"
        }
      }
    }
  }
}
