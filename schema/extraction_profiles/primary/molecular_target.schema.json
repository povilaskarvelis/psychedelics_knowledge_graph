{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Primary Molecular Target Extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "route_id",
    "study_doi",
    "domain_route",
    "paper_type",
    "text_depth",
    "extraction_status",
    "items",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "primary_molecular_target_v1"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "study_doi": {
      "type": "string"
    },
    "domain_route": {
      "type": "string",
      "const": "molecular_target"
    },
    "paper_type": {
      "type": "string",
      "enum": [
        "primary_study"
      ]
    },
    "text_depth": {
      "type": "string",
      "enum": [
        "article_text",
        "abstract_only"
      ]
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "extracted",
        "no_extractable_scoped_evidence",
        "wrong_source_type",
        "not_relevant",
        "human_review"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_type": {
      "type": "string"
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compound",
        "target",
        "target_type",
        "assay_type",
        "system",
        "sample_size",
        "study_design",
        "species_or_cell_line",
        "action_type",
        "metric",
        "value",
        "effect_or_statistic",
        "unit",
        "comparator_or_reference",
        "finding_summary",
        "evidence_location",
        "evidence_locator"
      ],
      "properties": {
        "compound": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "target_type": {
          "type": "string"
        },
        "assay_type": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "experimental_system_category": {
          "type": "string",
          "enum": [
            "clinical",
            "in_vivo",
            "ex_vivo",
            "in_vitro",
            "computational",
            "mixed_or_unclear",
            "not_reported"
          ],
          "description": "Experimental system category for the finding."
        },
        "sample_size": {
          "type": "string"
        },
        "study_design": {
          "type": "string"
        },
        "study_design_category": {
          "type": "string",
          "enum": [
            "rct",
            "phase_2_rct",
            "phase_3_rct",
            "open_label",
            "single_arm_trial",
            "clinical_trial",
            "observational",
            "retrospective",
            "case_report",
            "case_series",
            "qualitative",
            "preclinical_experiment",
            "ex_vivo_experiment",
            "in_vitro_assay",
            "binding_assay",
            "functional_assay",
            "computational",
            "pharmacovigilance",
            "wastewater_surveillance",
            "dose_finding",
            "post_hoc",
            "follow_up",
            "review",
            "systematic_review",
            "meta_analysis",
            "other",
            "not_reported"
          ],
          "description": "Coarse study-design bucket for filtering and UI facets. Use the closest allowed value."
        },
        "species_or_cell_line": {
          "type": "string"
        },
        "population_model_category": {
          "type": "string",
          "enum": [
            "clinical_population",
            "healthy_volunteers",
            "human_participants",
            "community_sample",
            "veterans",
            "adolescents_youth",
            "older_adults",
            "mouse_model",
            "rat_model",
            "animal_model",
            "in_vitro_cell_model",
            "ex_vivo_tissue_model",
            "computational_model",
            "mixed_or_unclear",
            "not_reported"
          ],
          "description": "Coarse population/model bucket for filtering and UI facets. Use the closest allowed value."
        },
        "action_type": {
          "type": "string"
        },
        "mechanistic_relationship_type": {
          "type": "string",
          "enum": [
            "binding_affinity",
            "agonism_antagonism",
            "transporter_uptake",
            "neurotransmitter_release",
            "expression_change",
            "connectivity_change",
            "plasticity_marker",
            "toxicity_marker",
            "metabolism_or_transport",
            "other_or_mixed",
            "not_reported"
          ],
          "description": "Kind of biological relationship being claimed, separate from the assay method."
        },
        "metric": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "effect_or_statistic": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "comparator_or_reference": {
          "type": "string"
        },
        "finding_summary": {
          "type": "string"
        },
        "evidence_location": {
          "type": "string"
        },
        "evidence_locator": {
          "type": "string"
        }
      }
    }
  }
}
