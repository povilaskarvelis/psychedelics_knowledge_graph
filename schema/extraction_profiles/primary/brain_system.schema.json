{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Primary Brain System Extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "route_id",
    "study_doi",
    "domain_route",
    "paper_type",
    "text_depth",
    "extraction_status",
    "items",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "primary_brain_system_v1"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "study_doi": {
      "type": "string"
    },
    "domain_route": {
      "type": "string",
      "const": "brain_system"
    },
    "paper_type": {
      "type": "string",
      "enum": [
        "primary_study"
      ]
    },
    "text_depth": {
      "type": "string",
      "enum": [
        "article_text",
        "abstract_only"
      ]
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "extracted",
        "no_extractable_scoped_evidence",
        "wrong_source_type",
        "not_relevant",
        "human_review"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_type": {
      "type": "string"
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compound_or_exposure",
        "population_or_system",
        "sample_size",
        "study_design",
        "modality",
        "primary_graph_anchor_kind",
        "brain_region",
        "brain_network",
        "neural_circuit",
        "readout",
        "task_or_state",
        "comparator",
        "dose_or_regimen",
        "assessment_timepoint",
        "statistic_or_value",
        "effect_or_statistic",
        "finding_summary",
        "evidence_location",
        "evidence_locator"
      ],
      "properties": {
        "compound_or_exposure": {
          "type": "string"
        },
        "population_or_system": {
          "type": "string"
        },
        "sample_size": {
          "type": "string"
        },
        "study_design": {
          "type": "string"
        },
        "modality": {
          "type": "string",
          "description": "Measurement modality or method family. Prefer familiar acronyms when used in the paper, such as EEG, ERP, MEG, fMRI, PET, SPECT, MRI, MRS, LFP, iEEG/ECoG, DTI, ASL, calcium imaging, or fiber photometry."
        },
        "primary_graph_anchor_kind": {
          "type": "string",
          "enum": [
            "brain_region",
            "brain_network",
            "neural_circuit",
            "biomarker_readout",
            "not_applicable",
            "uncertain"
          ]
        },
        "brain_region": {
          "type": "string"
        },
        "brain_network": {
          "type": "string"
        },
        "neural_circuit": {
          "type": "string"
        },
        "readout": {
          "type": "string",
          "description": "Neural measure or readout, not a brain region. Examples include MMN, P300/P3a/P3b, BOLD response, functional connectivity, receptor occupancy, cerebral blood flow, glucose metabolism, oscillatory power, neurochemical levels, calcium activity, c-Fos, brain structure, or white matter integrity."
        },
        "task_or_state": {
          "type": "string"
        },
        "comparator": {
          "type": "string"
        },
        "dose_or_regimen": {
          "type": "string"
        },
        "assessment_timepoint": {
          "type": "string",
          "description": "When the finding was measured or assessed, such as acute session, 2 hours post-dose, end of treatment, week 6, or follow-up. Use the paper's wording when available."
        },
        "statistic_or_value": {
          "type": "string",
          "description": "The main reported numeric/statistical value for the finding when no more specific value field applies, such as beta, r, mean difference, percent change, or a reported qualitative value."
        },
        "effect_or_statistic": {
          "type": "string"
        },
        "finding_summary": {
          "type": "string"
        },
        "evidence_location": {
          "type": "string"
        },
        "evidence_locator": {
          "type": "string"
        }
      }
    }
  }
}
