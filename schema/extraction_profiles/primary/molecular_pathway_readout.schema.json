{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Primary Molecular Pathway Or Readout Extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "route_id",
    "study_doi",
    "domain_route",
    "paper_type",
    "text_depth",
    "extraction_status",
    "items",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "primary_molecular_pathway_readout_v1"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "study_doi": {
      "type": "string"
    },
    "domain_route": {
      "type": "string",
      "const": "molecular_pathway_readout"
    },
    "paper_type": {
      "type": "string",
      "enum": [
        "primary_study"
      ]
    },
    "text_depth": {
      "type": "string",
      "enum": [
        "article_text",
        "abstract_only"
      ]
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "extracted",
        "no_extractable_scoped_evidence",
        "wrong_source_type",
        "not_relevant",
        "human_review"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_type": {
      "type": "string"
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compound_or_exposure",
        "pathway_or_readout",
        "assay_or_method",
        "model_system",
        "species_or_cell_line",
        "sample_size",
        "study_design",
        "tissue_or_sample",
        "dose_or_exposure",
        "assessment_timepoint",
        "quantitative_value",
        "effect_or_statistic",
        "unit",
        "finding_summary",
        "evidence_location",
        "evidence_locator"
      ],
      "properties": {
        "compound_or_exposure": {
          "type": "string"
        },
        "pathway_or_readout": {
          "type": "string",
          "description": "Legacy combined pathway/readout field. Prefer also filling molecular_effect_category and specific_readout_or_marker."
        },
        "molecular_effect_category": {
          "type": "string",
          "description": "Biological process parent for grouping the specific molecular pathway or readout. Use one of these recognizable process categories when applicable: Neuroplasticity; Neurogenesis; Intracellular signal transduction; Neuroinflammation & immune signaling; Neuronal excitability & synaptic transmission; Gene expression & activity markers; Epigenetic regulation; Genetic moderators; Receptor regulation & trafficking; Neurotransmitter release, uptake & turnover; Cellular stress & mitochondrial function; Cell injury & survival; Endocrine response; Drug metabolism; or Gut microbiome. Do not use a neurotransmitter system, assay method, brain region, or safety outcome as the parent, and do not replace the specific pathway or marker with this category."
        },
        "specific_readout_or_marker": {
          "type": "string",
          "description": "Specific measured marker, molecule, gene, protein, phosphorylation ratio, neurotransmitter, cytokine, metabolite, assay readout, tissue signal, or molecular endpoint retained as the graph entity, such as BDNF, c-Fos, phospho-mTOR/mTOR, IL-6, dopamine, glutamate, 5-HIAA, TrkB, or Iba1."
        },
        "mechanistic_relationship_type": {
          "type": "string",
          "enum": [
            "binding_affinity",
            "agonism_antagonism",
            "transporter_uptake",
            "neurotransmitter_release",
            "expression_change",
            "connectivity_change",
            "plasticity_marker",
            "toxicity_marker",
            "metabolism_or_transport",
            "other_or_mixed",
            "not_reported"
          ],
          "description": "Kind of biological relationship being claimed, separate from the assay method."
        },
        "assay_or_method": {
          "type": "string"
        },
        "model_system": {
          "type": "string"
        },
        "experimental_system_category": {
          "type": "string",
          "enum": [
            "clinical",
            "in_vivo",
            "ex_vivo",
            "in_vitro",
            "computational",
            "mixed_or_unclear",
            "not_reported"
          ],
          "description": "Experimental system category for the finding."
        },
        "population_model_category": {
          "type": "string",
          "enum": [
            "clinical_population",
            "healthy_volunteers",
            "human_participants",
            "community_sample",
            "veterans",
            "adolescents_youth",
            "older_adults",
            "mouse_model",
            "rat_model",
            "animal_model",
            "in_vitro_cell_model",
            "ex_vivo_tissue_model",
            "computational_model",
            "mixed_or_unclear",
            "not_reported"
          ],
          "description": "Coarse population/model bucket for filtering and UI facets. Use the closest allowed value."
        },
        "species_or_cell_line": {
          "type": "string"
        },
        "sample_size": {
          "type": "string"
        },
        "study_design": {
          "type": "string"
        },
        "study_design_category": {
          "type": "string",
          "enum": [
            "rct",
            "phase_2_rct",
            "phase_3_rct",
            "open_label",
            "single_arm_trial",
            "clinical_trial",
            "observational",
            "retrospective",
            "case_report",
            "case_series",
            "qualitative",
            "preclinical_experiment",
            "ex_vivo_experiment",
            "in_vitro_assay",
            "binding_assay",
            "functional_assay",
            "computational",
            "pharmacovigilance",
            "wastewater_surveillance",
            "dose_finding",
            "post_hoc",
            "follow_up",
            "review",
            "systematic_review",
            "meta_analysis",
            "other",
            "not_reported"
          ],
          "description": "Coarse study-design bucket for filtering and UI facets. Use the closest allowed value."
        },
        "tissue_or_sample": {
          "type": "string"
        },
        "dose_or_exposure": {
          "type": "string"
        },
        "assessment_timepoint": {
          "type": "string",
          "description": "When the finding was measured or assessed, such as acute session, 2 hours post-dose, end of treatment, week 6, or follow-up. Use the paper's wording when available."
        },
        "quantitative_value": {
          "type": "string"
        },
        "effect_or_statistic": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "finding_summary": {
          "type": "string"
        },
        "evidence_location": {
          "type": "string"
        },
        "evidence_locator": {
          "type": "string"
        }
      }
    }
  }
}
