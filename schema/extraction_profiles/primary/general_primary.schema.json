{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Primary General Fallback Extraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "route_id", "study_doi", "domain_route", "paper_type", "text_depth", "extraction_status", "items", "warnings"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["primary_general_primary_v1"]},
    "task_id": {"type": "string"},
    "source_type": {"type": "string"},
    "route_id": {"type": "string"},
    "study_doi": {"type": "string"},
    "domain_route": {"type": "string", "const": "general_primary"},
    "paper_type": {"type": "string", "enum": ["primary_study"]},
    "text_depth": {"type": "string", "enum": ["article_text", "abstract_only"]},
    "extraction_status": {"type": "string", "enum": ["extracted", "no_extractable_scoped_evidence", "wrong_source_type", "not_relevant", "human_review"]},
    "items": {"type": "array", "items": {"$ref": "#/definitions/item"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["best_domain_guess", "compound_or_exposure", "entity_or_endpoint", "measure_or_method", "population_or_system", "dose_or_context", "timepoint", "finding_summary", "why_general_fallback", "evidence_location", "evidence_quote"],
      "properties": {
        "best_domain_guess": {"type": "string"},
        "compound_or_exposure": {"type": "string"},
        "entity_or_endpoint": {"type": "string"},
        "measure_or_method": {"type": "string"},
        "population_or_system": {"type": "string"},
        "dose_or_context": {"type": "string"},
        "timepoint": {"type": "string"},
        "finding_summary": {"type": "string"},
        "why_general_fallback": {"type": "string"},
        "evidence_location": {"type": "string"},
        "evidence_quote": {"type": "string"}
      }
    }
  }
}
