{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Primary Pharmacokinetics And Exposure Extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "route_id",
    "study_doi",
    "domain_route",
    "paper_type",
    "text_depth",
    "extraction_status",
    "items",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "primary_pharmacokinetics_exposure_v3"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "study_doi": {
      "type": "string"
    },
    "domain_route": {
      "type": "string",
      "const": "pharmacokinetics_exposure"
    },
    "paper_type": {
      "type": "string",
      "enum": [
        "primary_study"
      ]
    },
    "text_depth": {
      "type": "string",
      "enum": [
        "article_text",
        "abstract_only"
      ]
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "extracted",
        "no_extractable_scoped_evidence",
        "wrong_source_type",
        "not_relevant",
        "human_review"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_type": {
      "type": "string"
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compound_or_analyte",
        "primary_graph_anchor_kind",
        "pk_relationship_type",
        "pk_graph_object_kind",
        "pk_graph_object_label",
        "analyte_type",
        "metabolite_or_analyte",
        "matrix",
        "pk_or_exposure_parameter",
        "value",
        "effect_or_statistic",
        "unit",
        "dose",
        "route_of_administration",
        "sampling_time_or_window",
        "population_or_system",
        "sample_size",
        "study_design",
        "metabolic_or_transport_target",
        "metabolic_or_transport_pathway",
        "model_or_method",
        "finding_summary",
        "evidence_location",
        "evidence_locator"
      ],
      "properties": {
        "compound_or_analyte": {
          "type": "string"
        },
        "primary_graph_anchor_kind": {
          "type": "string",
          "enum": [
            "pharmacokinetic_parameter",
            "compound",
            "target",
            "pathway_process",
            "not_applicable",
            "uncertain"
          ],
          "description": "Compatibility graph anchor kind for the current KG table builder. Prefer compound for metabolites/analytes, target for enzymes/transporters, pathway_process for metabolic or transport pathways, and pharmacokinetic_parameter only when no more specific PK object is supported."
        },
        "pk_relationship_type": {
          "type": "string",
          "enum": [
            "exposure_characterized",
            "metabolized_to",
            "metabolized_by",
            "metabolized_via",
            "exposure_altered_by",
            "route_or_formulation_changes_exposure",
            "distributed_to",
            "eliminated_by",
            "exposure_linked_to_effect",
            "detected_or_monitored_in",
            "other_pk_relationship",
            "not_applicable",
            "uncertain"
          ],
          "description": "The specific pharmacokinetic relationship supported by this finding. Use a relationship that says what happens to the compound or what changes its exposure, rather than the metric that was measured."
        },
        "pk_graph_object_kind": {
          "type": "string",
          "enum": [
            "parent_or_analyte_exposure",
            "metabolite_or_analyte",
            "enzyme_or_transporter",
            "metabolic_or_transport_pathway",
            "route_or_formulation",
            "compartment_or_tissue",
            "modifier_or_interaction",
            "effect_or_response",
            "excretion_or_elimination",
            "detection_or_monitoring",
            "other_pk_object",
            "not_applicable",
            "uncertain"
          ],
          "description": "The kind of object that should appear on the non-compound side of the PK graph."
        },
        "pk_graph_object_label": {
          "type": "string",
          "description": "Short user-facing graph object label. Prefer specific PK objects such as psilocin, noribogaine, CYP2D6, MAO-A, oral bioavailability, brain exposure, urinary excretion, escitalopram pretreatment, or blood pressure response. Avoid metric-only labels such as Cmax, AUC, or Tmax unless no more meaningful object is supported."
        },
        "analyte_type": {
          "type": "string"
        },
        "metabolite_or_analyte": {
          "type": "string"
        },
        "matrix": {
          "type": "string"
        },
        "pk_or_exposure_parameter": {
          "type": "string",
          "description": "A true pharmacokinetic or exposure metric such as Cmax, Tmax, AUC, half-life, clearance, bioavailability, concentration, volume of distribution, metabolic ratio, or Km. EC50, IC50, ED50, receptor occupancy, and dose-response metrics are pharmacodynamic unless the finding explicitly links them to measured concentration or exposure; otherwise route them to molecular target or molecular pathway/readout."
        },
        "value": {
          "type": "string"
        },
        "effect_or_statistic": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "dose": {
          "type": "string"
        },
        "route_of_administration": {
          "type": "string"
        },
        "sampling_time_or_window": {
          "type": "string",
          "description": "When samples or pharmacokinetic measurements were collected, or the sampling window summarized by the result. Use the paper's wording when available."
        },
        "population_or_system": {
          "type": "string"
        },
        "sample_size": {
          "type": "string"
        },
        "study_design": {
          "type": "string"
        },
        "metabolic_or_transport_target": {
          "type": "string"
        },
        "metabolic_or_transport_pathway": {
          "type": "string"
        },
        "model_or_method": {
          "type": "string"
        },
        "finding_summary": {
          "type": "string"
        },
        "evidence_location": {
          "type": "string"
        },
        "evidence_locator": {
          "type": "string"
        }
      }
    }
  }
}
