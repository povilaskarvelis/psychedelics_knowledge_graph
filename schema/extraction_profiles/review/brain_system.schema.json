{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Psychedelics KG Secondary Review Coverage Extraction - brain_system",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "route_id",
    "study_doi",
    "domain_route",
    "source_type",
    "text_depth",
    "source_text_provenance",
    "extraction_status",
    "review_assessment",
    "coverage_items",
    "extraction_warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "review_coverage_v1"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "study_doi": {
      "type": "string",
      "minLength": 1
    },
    "domain_route": {
      "type": "string",
      "const": "brain_system"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "systematic_review",
        "scoping_review",
        "umbrella_review",
        "review",
        "narrative_review",
        "literature_review",
        "secondary_evidence",
        "uncertain"
      ]
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "extracted",
        "no_extractable_scoped_coverage",
        "not_relevant",
        "wrong_source_type",
        "human_review"
      ]
    },
    "review_assessment": {
      "$ref": "#/definitions/review_assessment"
    },
    "coverage_items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/coverage_item"
      }
    },
    "extraction_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "text_depth": {
      "type": "string",
      "enum": [
        "article_text",
        "abstract_only"
      ]
    },
    "source_text_provenance": {
      "$ref": "#/definitions/source_text_provenance"
    }
  },
  "definitions": {
    "domain_route": {
      "type": "string",
      "const": "brain_system"
    },
    "evidence_location": {
      "type": "string",
      "enum": [
        "abstract",
        "text",
        "table",
        "figure",
        "supplement",
        "metadata",
        "not_reported"
      ]
    },
    "direction_or_tone": {
      "type": "string",
      "enum": [
        "supports",
        "mixed",
        "does_not_support",
        "insufficient_evidence",
        "descriptive_only",
        "unclear",
        "not_applicable"
      ]
    },
    "review_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_in_scope",
        "review_type",
        "has_extractable_scoped_coverage",
        "relationship_domain",
        "population_or_system",
        "primary_compounds_or_classes",
        "primary_entities",
        "needs_human_review",
        "reasoning_summary",
        "evidence_location",
        "evidence_locator"
      ],
      "properties": {
        "is_in_scope": {
          "type": "boolean"
        },
        "review_type": {
          "type": "string"
        },
        "has_extractable_scoped_coverage": {
          "type": "boolean"
        },
        "relationship_domain": {
          "type": "string",
          "const": "brain_system"
        },
        "population_or_system": {
          "type": "string"
        },
        "primary_compounds_or_classes": {
          "type": "string"
        },
        "primary_entities": {
          "type": "string"
        },
        "needs_human_review": {
          "type": "boolean"
        },
        "reasoning_summary": {
          "type": "string"
        },
        "evidence_location": {
          "$ref": "#/definitions/evidence_location"
        },
        "evidence_locator": {
          "type": "string"
        }
      }
    },
    "coverage_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "relationship_domain",
        "coverage_type",
        "coverage_focus",
        "compound_or_class",
        "entity_type",
        "entity",
        "population_or_system",
        "reviewed_evidence_type",
        "summary_statement",
        "direction_or_tone",
        "participant_or_sample_summary",
        "key_limitations",
        "evidence_location",
        "evidence_locator",
        "confidence",
        "needs_human_review",
        "domain_result"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "relationship_domain": {
          "type": "string",
          "const": "brain_system"
        },
        "coverage_type": {
          "type": "string",
          "enum": [
            "summarizes",
            "reviews",
            "maps_evidence",
            "discusses",
            "identifies_gap",
            "methodological_context",
            "mentions",
            "uncertain"
          ]
        },
        "coverage_focus": {
          "type": "string",
          "enum": [
            "main_focus",
            "substantial_topic",
            "brief_context",
            "unclear"
          ],
          "description": "How central this coverage item is to the review: main focus, substantial topic, brief context, or unclear."
        },
        "compound_or_class": {
          "type": "string"
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "brain_region",
            "brain_network",
            "neural_circuit",
            "biomarker_readout",
            "not_applicable",
            "uncertain"
          ]
        },
        "entity": {
          "type": "string"
        },
        "population_or_system": {
          "type": "string"
        },
        "reviewed_evidence_type": {
          "type": "string"
        },
        "summary_statement": {
          "type": "string"
        },
        "direction_or_tone": {
          "$ref": "#/definitions/direction_or_tone"
        },
        "participant_or_sample_summary": {
          "type": "string"
        },
        "key_limitations": {
          "type": "string"
        },
        "evidence_location": {
          "$ref": "#/definitions/evidence_location"
        },
        "evidence_locator": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_human_review": {
          "type": "boolean"
        },
        "domain_result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compound_or_exposure",
            "primary_graph_anchor_kind",
            "brain_region",
            "brain_network",
            "neural_circuit",
            "modality_or_evidence_type",
            "readout_or_measure",
            "neural_effect_or_alteration",
            "task_or_state",
            "system_or_species",
            "comparator_or_reference",
            "timepoint_or_window",
            "dose_or_exposure_context",
            "direction_or_change",
            "review_interpretation"
          ],
          "properties": {
            "compound_or_exposure": {
              "type": "string",
              "description": "Compound, intervention, dose, drug class, or exposure linked to the brain-system review."
            },
            "primary_graph_anchor_kind": {
              "type": "string",
              "enum": [
                "brain_region",
                "brain_network",
                "neural_circuit",
                "biomarker_readout",
                "not_applicable",
                "uncertain"
              ],
              "description": "Graph node kind that should anchor this brain-system item: brain region, brain network, neural circuit, measured neural readout, not applicable, or uncertain."
            },
            "brain_region": {
              "type": "string",
              "description": "Named anatomical brain region or subregion when the text supports one; use not_reported when none is stated."
            },
            "brain_network": {
              "type": "string",
              "description": "Named functional brain network when the text supports one; use not_reported when none is stated."
            },
            "neural_circuit": {
              "type": "string",
              "description": "Named circuit, projection, region-to-region relationship, or circuit-level relationship when stated; use not_reported when none is stated."
            },
            "modality_or_evidence_type": {
              "type": "string",
              "description": "Measurement modality or evidence type. Prefer familiar acronyms when used in the paper, such as EEG, ERP, MEG, fMRI, PET, SPECT, MRI, MRS, LFP, iEEG/ECoG, DTI, ASL, calcium imaging, fiber photometry, postmortem, lesion, animal neurobiology, or computational evidence."
            },
            "readout_or_measure": {
              "type": "string",
              "description": "Neural readout or measure reviewed, not a brain region. Examples include MMN, P300/P3a/P3b, BOLD response, functional connectivity, receptor/transporter binding or occupancy, cerebral blood flow, glucose metabolism, oscillatory power, neurochemical levels, calcium activity, c-Fos, brain structure, white matter integrity, sleep architecture, or not reported."
            },
            "neural_effect_or_alteration": {
              "type": "string",
              "description": "Reviewed neural effect, alteration, connectivity change, activation pattern, structural change, or neurophysiological effect."
            },
            "task_or_state": {
              "type": "string",
              "description": "Task, resting state, acute drug state, disease state, behavioral state, or not reported."
            },
            "system_or_species": {
              "type": "string",
              "description": "Human, animal, cellular, computational, clinical, preclinical, or mixed system reviewed."
            },
            "comparator_or_reference": {
              "type": "string",
              "description": "Comparator, reference condition, baseline, control group, disease state, abstinence state, sham condition, or not reported."
            },
            "timepoint_or_window": {
              "type": "string",
              "description": "Timing of the reviewed brain-system evidence, such as acute session, post-treatment follow-up, chronic exposure, abstinence period, 24-hour sampling, or not reported."
            },
            "dose_or_exposure_context": {
              "type": "string",
              "description": "Dose, regimen, administration pattern, exposure level, acute/chronic use context, or not reported."
            },
            "direction_or_change": {
              "type": "string",
              "description": "Direction of the neural effect when stated, such as increased, decreased, weakened, strengthened, normalized, mixed, no clear change, or not reported."
            },
            "review_interpretation": {
              "type": "string",
              "description": "Short interpretation of what this review coverage means for brain systems."
            }
          }
        }
      }
    },
    "source_text_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_depth",
        "source_text_kind",
        "source_text_scope"
      ],
      "properties": {
        "text_depth": {
          "type": "string",
          "enum": [
            "article_text",
            "abstract_only"
          ]
        },
        "source_text_kind": {
          "type": "string",
          "enum": [
            "article_text",
            "abstract_only"
          ]
        },
        "source_text_scope": {
          "type": "string"
        }
      }
    }
  }
}
