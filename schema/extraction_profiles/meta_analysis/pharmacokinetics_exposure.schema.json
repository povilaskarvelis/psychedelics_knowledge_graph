{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Psychedelics KG Meta-Analysis Extraction - pharmacokinetics_exposure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "route_id",
    "study_doi",
    "domain_route",
    "source_type",
    "text_depth",
    "source_text_provenance",
    "extraction_status",
    "synthesis_assessment",
    "included_evidence_summary",
    "synthesis_results",
    "extraction_warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "meta_analysis_evidence_v1"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "study_doi": {
      "type": "string",
      "minLength": 1
    },
    "domain_route": {
      "type": "string",
      "const": "pharmacokinetics_exposure"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "meta_analysis",
        "network_meta_analysis",
        "umbrella_review",
        "systematic_review",
        "secondary_evidence",
        "uncertain"
      ]
    },
    "text_depth": {
      "type": "string",
      "enum": [
        "article_text",
        "abstract_only"
      ]
    },
    "source_text_provenance": {
      "$ref": "#/definitions/source_text_provenance"
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "extracted",
        "no_extractable_synthesis_result",
        "not_relevant",
        "wrong_source_type",
        "human_review"
      ]
    },
    "synthesis_assessment": {
      "$ref": "#/definitions/synthesis_assessment"
    },
    "included_evidence_summary": {
      "$ref": "#/definitions/included_evidence_summary"
    },
    "synthesis_results": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/synthesis_result"
      }
    },
    "extraction_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "domain_route": {
      "type": "string",
      "const": "pharmacokinetics_exposure"
    },
    "evidence_location": {
      "type": "string",
      "enum": [
        "abstract",
        "text",
        "table",
        "figure",
        "supplement",
        "metadata",
        "not_reported"
      ]
    },
    "result_direction": {
      "type": "string",
      "enum": [
        "positive",
        "no_detected_effect",
        "negative",
        "mixed",
        "unclear",
        "not_applicable"
      ]
    },
    "source_text_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_depth",
        "source_text_kind",
        "source_text_scope"
      ],
      "properties": {
        "text_depth": {
          "type": "string",
          "enum": [
            "article_text",
            "abstract_only"
          ]
        },
        "source_text_kind": {
          "type": "string",
          "enum": [
            "article_text",
            "abstract_only"
          ]
        },
        "source_text_scope": {
          "type": "string"
        }
      }
    },
    "synthesis_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_in_scope",
        "is_meta_analysis",
        "is_network_meta_analysis",
        "has_extractable_quantitative_results",
        "relationship_domain",
        "population_or_system",
        "primary_compounds_or_classes",
        "primary_entities",
        "needs_human_review",
        "reasoning_summary",
        "evidence_location",
        "evidence_locator"
      ],
      "properties": {
        "is_in_scope": {
          "type": "boolean"
        },
        "is_meta_analysis": {
          "type": "boolean"
        },
        "is_network_meta_analysis": {
          "type": "boolean"
        },
        "has_extractable_quantitative_results": {
          "type": "boolean"
        },
        "relationship_domain": {
          "type": "string",
          "const": "pharmacokinetics_exposure"
        },
        "population_or_system": {
          "type": "string"
        },
        "primary_compounds_or_classes": {
          "type": "string"
        },
        "primary_entities": {
          "type": "string"
        },
        "needs_human_review": {
          "type": "boolean"
        },
        "reasoning_summary": {
          "type": "string"
        },
        "evidence_location": {
          "$ref": "#/definitions/evidence_location"
        },
        "evidence_locator": {
          "type": "string"
        }
      }
    },
    "included_evidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_study_count",
        "included_participant_count",
        "included_experiment_or_assay_count",
        "included_evidence_type_summary",
        "study_year_range",
        "country_or_region_summary",
        "evidence_location",
        "evidence_locator"
      ],
      "properties": {
        "included_study_count": {
          "type": "string"
        },
        "included_participant_count": {
          "type": "string"
        },
        "included_experiment_or_assay_count": {
          "type": "string"
        },
        "included_evidence_type_summary": {
          "type": "string"
        },
        "study_year_range": {
          "type": "string"
        },
        "country_or_region_summary": {
          "type": "string"
        },
        "evidence_location": {
          "$ref": "#/definitions/evidence_location"
        },
        "evidence_locator": {
          "type": "string"
        }
      }
    },
    "synthesis_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "result_role",
        "relationship_domain",
        "compound_or_class",
        "entity_type",
        "entity",
        "population_or_system",
        "intervention_or_exposure",
        "comparator",
        "outcome_or_endpoint",
        "outcome_measure",
        "timepoint_or_window",
        "effect_metric",
        "effect_size",
        "study_count",
        "participant_count",
        "result_direction",
        "authors_interpretation",
        "domain_result",
        "evidence_location",
        "evidence_locator",
        "confidence",
        "needs_human_review"
      ],
      "properties": {
        "result_id": {
          "type": "string"
        },
        "result_role": {
          "type": "string",
          "enum": [
            "main_result",
            "secondary_result",
            "subgroup_result",
            "sensitivity_analysis",
            "meta_regression",
            "publication_bias",
            "network_comparison",
            "network_ranking",
            "dose_response",
            "other",
            "uncertain"
          ]
        },
        "relationship_domain": {
          "type": "string",
          "const": "pharmacokinetics_exposure"
        },
        "compound_or_class": {
          "type": "string"
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "pharmacokinetic_parameter",
            "compound",
            "target",
            "pathway_process",
            "not_applicable",
            "uncertain"
          ]
        },
        "entity": {
          "type": "string"
        },
        "population_or_system": {
          "type": "string"
        },
        "intervention_or_exposure": {
          "type": "string"
        },
        "comparator": {
          "type": "string"
        },
        "outcome_or_endpoint": {
          "type": "string"
        },
        "outcome_measure": {
          "type": "string"
        },
        "timepoint_or_window": {
          "type": "string"
        },
        "effect_metric": {
          "type": "string"
        },
        "effect_size": {
          "type": "string"
        },
        "study_count": {
          "type": "string"
        },
        "participant_count": {
          "type": "string"
        },
        "result_direction": {
          "type": "string",
          "const": "not_applicable"
        },
        "authors_interpretation": {
          "type": "string"
        },
        "domain_result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compound_or_analyte",
            "primary_graph_anchor_kind",
            "exposure_evidence_category",
            "analyte_type",
            "metabolite_or_analyte",
            "matrix",
            "pk_or_exposure_parameter",
            "value",
            "unit",
            "dose",
            "route_of_administration",
            "sampling_time_or_window",
            "population_or_system",
            "comparator_or_reference",
            "exposure_response_or_pk_effect",
            "synthesis_interpretation"
          ],
          "properties": {
            "compound_or_analyte": {
              "type": "string",
              "description": "Compound, metabolite, analyte, drug class, or exposure being synthesized."
            },
            "primary_graph_anchor_kind": {
              "type": "string",
              "enum": [
                "pharmacokinetic_parameter",
                "compound",
                "target",
                "pathway_process",
                "not_applicable",
                "uncertain"
              ],
              "description": "Graph node kind that should anchor this PK/exposure item: PK parameter, compound/analyte/metabolite, target enzyme or transporter, pathway/process, not applicable, or uncertain."
            },
            "exposure_evidence_category": {
              "type": "string",
              "description": "Broad evidence type such as PK parameter, concentration level, metabolism, dose-response, exposure-response, drug-drug interaction, dose or route modifier, dose equivalence, bioavailability, or delivery limitation."
            },
            "analyte_type": {
              "type": "string",
              "description": "Analyte category such as parent drug, metabolite, biomarker, dose, exposure index, or PK/PD parameter."
            },
            "metabolite_or_analyte": {
              "type": "string",
              "description": "Metabolite, analyte, alkaloid, concentration component, or relevant chemical species reviewed."
            },
            "matrix": {
              "type": "string",
              "description": "Biological matrix or data source, such as plasma, serum, blood, urine, CSF, tissue, model, or not applicable."
            },
            "pk_or_exposure_parameter": {
              "type": "string",
              "description": "PK, exposure, dose-response, exposure-response, metabolism, or concentration parameter such as Cmax, AUC, Tmax, half-life, clearance, dose slope, or peak effect timing."
            },
            "value": {
              "type": "string",
              "description": "Reported value or estimate for the PK/exposure parameter."
            },
            "unit": {
              "type": "string",
              "description": "Unit for the reported value, if applicable."
            },
            "dose": {
              "type": "string",
              "description": "Dose or dose range linked to the exposure finding."
            },
            "route_of_administration": {
              "type": "string",
              "description": "Route such as oral, intravenous, intranasal, subcutaneous, or not reported."
            },
            "sampling_time_or_window": {
              "type": "string",
              "description": "Sampling time, effect window, follow-up interval, or timing relative to dose."
            },
            "population_or_system": {
              "type": "string",
              "description": "Participant group, patient group, animal model, or experimental system."
            },
            "comparator_or_reference": {
              "type": "string",
              "description": "Reference condition for the exposure result, such as placebo, baseline, dose level, route, enantiomer, coadministered medication, responder group, control group, or reference category."
            },
            "exposure_response_or_pk_effect": {
              "type": "string",
              "description": "Observed PK, exposure, dose-response, exposure-response, or drug-interaction effect such as increased exposure, attenuated effect, nonlinear response, higher concentration in responders, no consistent association, or delivery-limited bioavailability."
            },
            "synthesis_interpretation": {
              "type": "string",
              "description": "Short interpretation of what the synthesis result means for PK, exposure, or dose/exposure response."
            }
          }
        },
        "evidence_location": {
          "$ref": "#/definitions/evidence_location"
        },
        "evidence_locator": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_human_review": {
          "type": "boolean"
        }
      }
    }
  }
}
