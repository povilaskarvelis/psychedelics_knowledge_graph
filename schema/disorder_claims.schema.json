{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Psychedelics Disorder Claims",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "compound",
      "disorder",
      "outcome_type",
      "result_direction",
      "paper_type",
      "authors",
      "study_year",
      "evidence_level",
      "source",
      "source_type",
      "access_level",
      "evidence_location",
      "evidence_locator",
      "study_design"
    ],
    "properties": {
      "compound": {"type": "string"},
      "disorder": {"type": "string"},
      "outcome_type": {"type": "string"},
      "result_direction": {
        "type": "string",
        "enum": ["positive", "null", "negative", "mixed", "unclear"]
      },
      "outcome_measure": {"type": "string"},
      "population": {"type": "string"},
      "system": {"type": "string", "enum": ["clinical", "preclinical", "observational", "unknown"]},
      "study_doi": {"type": "string"},
      "openalex_id": {"type": "string"},
      "study_title": {"type": "string"},
      "authors": {"type": "string"},
      "study_year": {"type": "integer"},
      "paper_type": {
        "type": "string",
        "enum": ["primary_results", "review", "protocol", "conference_or_poster_abstract", "other"]
      },
      "evidence_level": {"type": "string", "enum": ["low", "medium", "high"]},
      "source": {"type": "string"},
      "source_type": {
        "type": "string",
        "enum": ["primary_study", "review", "meta_analysis", "registry", "other"]
      },
      "access_level": {
        "type": "string",
        "enum": ["full_text_seen", "abstract_only", "secondary_summary"]
      },
      "evidence_location": {
        "type": "string",
        "enum": ["table", "figure", "text", "abstract", "supplement", "mixed", "unknown"]
      },
      "evidence_locator": {"type": "string"},
      "study_design": {"type": "string"},
      "notes": {"type": "string"}
    },
    "oneOf": [
      {"required": ["study_doi"]},
      {"required": ["openalex_id"]}
    ]
  }
}
