{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/psychedelics_knowledge_graph/search_manifest.schema.json",
  "title": "Literature Search Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "dataset",
    "research_question",
    "databases",
    "query_blocks",
    "inclusion_criteria",
    "exclusion_criteria",
    "recall_gate"
  ],
  "properties": {
    "protocol_version": {"type": "string"},
    "dataset": {"type": "string", "enum": ["mechanistic", "disorder"]},
    "research_question": {"type": "string"},
    "databases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "identifier_strategy"],
        "properties": {
          "name": {"type": "string"},
          "role": {"type": "string"},
          "identifier_strategy": {"type": "string"},
          "rate_limit_notes": {"type": "string"},
          "requires_api_key": {"type": "boolean"}
        }
      }
    },
    "query_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "entities", "query_templates"],
        "properties": {
          "label": {"type": "string"},
          "entities": {
            "type": "object",
            "additionalProperties": {"type": "array", "items": {"type": "string"}}
          },
          "query_templates": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "inclusion_criteria": {"type": "array", "items": {"type": "string"}},
    "exclusion_criteria": {"type": "array", "items": {"type": "string"}},
    "recall_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark_doi_file", "minimum_discovered_percent", "minimum_triage_percent"],
      "properties": {
        "benchmark_doi_file": {"type": "string"},
        "minimum_discovered_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "minimum_triage_percent": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
