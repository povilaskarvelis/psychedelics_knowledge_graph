# Copy this file to .env and fill in project-local credentials.
# .env is ignored by git.

GEMINI_API_KEY=
# Global fallback used by older/general Gemini scripts.
GEMINI_MODEL=gemini-2.5-flash
# Route-aware extraction defaults.
GEMINI_ROUTE_EXTRACTION_MODEL=gemini-3-flash-preview
GEMINI_ABSTRACT_EXTRACTION_MODEL=gemini-3-flash-preview
GEMINI_ARTICLE_TEXT_EXTRACTION_MODEL=gemini-3-flash-preview

# Optional read-only query API / MCP deployment settings.
PKG_DATA_DIR=
PKG_PUBLIC_BASE_URL=http://127.0.0.1:8000
PKG_CORS_ORIGINS=
PKG_MCP_ALLOWED_HOSTS=
PKG_MCP_ALLOWED_ORIGINS=

# Public Cloudflare R2 bucket used only for browser payloads. This bucket may be
# connected to data.psychedelicskg.com. Use a bucket-scoped read/write token.
PKG_R2_ACCOUNT_ID=
PKG_R2_BUCKET=psychedelics-kg-releases
PKG_R2_ACCESS_KEY_ID=
PKG_R2_SECRET_ACCESS_KEY=
PKG_R2_JURISDICTION=
PKG_R2_ENDPOINT_URL=
PKG_R2_BROWSER_PREFIX=browser

# Private Cloudflare R2 bucket used only by the query API runtime. Do not attach
# a custom domain or enable r2.dev access. The local publisher needs read/write
# credentials; configure a separate read-only token in Render under these same
# variable names.
PKG_API_R2_ACCOUNT_ID=
PKG_API_R2_BUCKET=psychedelics-kg-api-private
PKG_API_R2_ACCESS_KEY_ID=
PKG_API_R2_SECRET_ACCESS_KEY=
PKG_API_R2_JURISDICTION=
PKG_API_R2_ENDPOINT_URL=
PKG_API_R2_PREFIX=query-api

# Optional Render (or other platform) deploy hook. The R2 publisher calls it
# after switching the remote active pointer so data updates need no Git commit.
PKG_DEPLOY_HOOK_URL=
