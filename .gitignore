# macOS
.DS_Store

# Python runtime artifacts
__pycache__/
*.py[cod]
.pytest_cache/

# Generated run logs
logs/

# Local environment / secrets
.env
.env.*
*.env
!.env.example
pipeline/config.local.yaml
pipeline/config.*.local.yaml

# Local/generated data stores. Keep only the static-site payloads versioned;
# generated pipeline outputs under data/ should stay out of commits.
data/*
!data/curated/
data/curated/*
!data/curated/entity_registry.json
!data/processed/
data/processed/*
!data/processed/bibliography_payload_*.json
!data/processed/graph_payload_active.json
